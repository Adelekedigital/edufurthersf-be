APP_NAME=scholarship-finder
APP_VERSION=0.1.0
ENVIRONMENT=development
# Generic postgres:// and postgresql:// URLs are normalized to asyncpg automatically.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scholarship_finder
DB_CONNECT_TIMEOUT_SECONDS=3
API_RATE_LIMIT_PER_MINUTE=30
CORE_JOIN_INTENT_URL=
CORE_SERVICE_TOKEN=
CORE_ALLOWED_RETURN_URL_PREFIX=
INTERNAL_SERVICE_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_EXPECTED_DESTINATION=
QSTASH_URL=https://qstash.upstash.io
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0


