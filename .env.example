APP_NAME=scholarship-finder
APP_VERSION=0.1.0
ENVIRONMENT=development
# Generic postgres:// and postgresql:// URLs are normalized to asyncpg automatically.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scholarship_finder
DB_CONNECT_TIMEOUT_SECONDS=3
API_RATE_LIMIT_PER_MINUTE=30
# Core API root. Its reference catalogues are public, so no token is sent.
CORE_BASE_URL=
CORE_JOIN_INTENT_URL=
CORE_SERVICE_TOKEN=
# Matched structurally on scheme, host, port and a path boundary; set the full
# origin (and any required path prefix), e.g. https://app.edufurther.com/
CORE_ALLOWED_RETURN_URL_PREFIX=
INTERNAL_SERVICE_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_TOKEN=
# Required in staging and production: the exact public URL QStash publishes to.
QSTASH_EXPECTED_DESTINATION=
QSTASH_URL=https://qstash.upstash.io
# Required in staging and production; the development placeholder is refused.
CURSOR_SECRET=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Tri-state: leave unset to follow ENVIRONMENT (on for staging/production, off
# for local dev). Set true/false to override that default explicitly.
SENTRY_ENABLED=

# The shared AI Router (LiteLLM + Langfuse), a platform capability owned
# outside both Core and Finder. Auth is a short-lived RS256 JWT Finder signs
# in-process - AI_ROUTER_PRIVATE_KEY_PEM is a keypair, not a static secret
# string handed to us. AI_ROUTER_KEY_ID is the registered `kid`; bump it (and
# re-register with the router) on every rotation, never reuse one. See
# docs/integration-scholarship-finder.md on the router side for setup.
AI_ROUTER_BASE_URL=
AI_ROUTER_PRIVATE_KEY_PEM=
AI_ROUTER_KEY_ID=
# Off until reviewed and explicitly turned on - a working keypair alone must
# not be enough to put a live AI-generated explanation in front of a real
# searcher.
MATCH_EXPLANATION_ENABLED=false

# Read directly by the Parse SDK from the process environment, not through
# app.core.config. Required for the harvest_parsebot job to reach
# ScholarshipPortal/PhDScanner/Mastersportal; see README's "Parse.bot
# harvest" section.
PARSE_API_KEY=

# External research APIs that widen scholarship discovery/verification
# beyond Parse.bot (Tavily: web-search discovery; Jina.ai: an alternative
# page-fetcher for pages the default fetcher struggles with). Plain HTTP, no
# vendor SDK. A key left unset keeps that provider off entirely, the same
# pattern PARSE_API_KEY/POSTHOG_API_KEY already use. See
# app/infra/research_budget.py for the monthly-call enforcement.
TAVILY_API_KEY=
TAVILY_MONTHLY_SEARCH_LIMIT=900
JINA_API_KEY=
JINA_MONTHLY_CALL_LIMIT=500

POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Same tri-state rationale as SENTRY_ENABLED above.
POSTHOG_DISPATCH_ENABLED=

# Freshness/re-verification cadence (data-verification standard section 8).
# Every value below has a working default matching that standard's cadence
# table - none need to be set to activate refresh_status/reverify_due, only
# to tune them. See Settings in app/core/config.py for the complete,
# authoritative list if this drifts out of sync with it.
FRESHNESS_NEAR_DEADLINE_DAYS=14
FRESHNESS_UPCOMING_NEAR_MONTHS=1
FRESHNESS_UPCOMING_FAR_MONTHS=2
FRESHNESS_OPEN_FAR_FETCH_HOURS=24
FRESHNESS_OPEN_FAR_MAX_AGE_HOURS=48
FRESHNESS_OPEN_NEAR_FETCH_HOURS=6
FRESHNESS_OPEN_NEAR_MAX_AGE_HOURS=12
FRESHNESS_ROLLING_FETCH_HOURS=24
FRESHNESS_ROLLING_MAX_AGE_HOURS=48
FRESHNESS_UPCOMING_NEAR_FETCH_HOURS=24
FRESHNESS_UPCOMING_FAR_FETCH_HOURS=168
FRESHNESS_UPCOMING_MAX_AGE_HOURS=336
FRESHNESS_UNKNOWN_FETCH_HOURS=720
FRESHNESS_UNKNOWN_MAX_AGE_HOURS=1440
FRESHNESS_CLOSED_FETCH_HOURS=2160
FRESHNESS_CLOSED_MAX_AGE_HOURS=4320
REFRESH_STATUS_BATCH_LIMIT=500
REVERIFY_DUE_BATCH_LIMIT=100
